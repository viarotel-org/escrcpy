+static bool
+parse_parent_window_handle(const char *s, uintptr_t *handle) {
+    if (!s[0]) {
+        LOGE("Parent window handle must not be empty");
+        return false;
+    }
+
+    errno = 0;
+    char *end;
+    uintmax_t value = strtoumax(s, &end, 0);
+    if (errno || *end || !value || value > UINTPTR_MAX) {
+        LOGE("Invalid parent window handle: %s", s);
+        return false;
+    }
+
+    *handle = (uintptr_t) value;
+    return true;
+}
