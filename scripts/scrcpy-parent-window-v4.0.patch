@@ -27,16 +35,78 @@ sc_sdl_create_window(const char *title, int64_t x, int64_t y, int64_t width,
     ok &= SDL_SetNumberProperty(props, SDL_PROP_WINDOW_CREATE_FLAGS_NUMBER,
                                 flags);
 
+#ifdef _WIN32
+    if (parent_window_handle) {
+        HWND parent = (HWND) parent_window_handle;
+        if (!IsWindow(parent)) {
+            SDL_SetError("Invalid parent window handle");
+            ok = false;
+        } else {
+            DWORD style = WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS;
+            child = CreateWindowExW(0, L"STATIC", L"", style,
+                                    0, 0, (int) width, (int) height,
+                                    parent, NULL, GetModuleHandleW(NULL), NULL);
+            if (!child) {
+                SDL_SetError("Could not create the embedded child window");
+                ok = false;
+            } else {
+                ok &= SDL_SetPointerProperty(
+                    props, SDL_PROP_WINDOW_CREATE_WIN32_HWND_POINTER, child);
+            }
+        }
+    }
+#else
+    if (parent_window_handle) {
+        SDL_SetError("Parent window handles are only supported on Windows");
+        ok = false;
+    }
+#endif
+
     if (!ok) {
+#ifdef _WIN32
+        if (child) {
+            DestroyWindow(child);
+        }
+#endif
         SDL_DestroyProperties(props);
         return NULL;
     }
 
     window = SDL_CreateWindowWithProperties(props);
     SDL_DestroyProperties(props);
+
+#ifdef _WIN32
+    if (!window && child) {
+        DestroyWindow(child);
+    } else if (window && child) {
+        SDL_SetBooleanProperty(SDL_GetWindowProperties(window),
+                               "escrcpy.win32.owned_child", true);
+    }
+#endif
     return window;
 }
 
+void
+sc_sdl_destroy_window(SDL_Window *window) {
+#ifdef _WIN32
+    SDL_PropertiesID props = SDL_GetWindowProperties(window);
+    bool owned_child = SDL_GetBooleanProperty(
+        props, "escrcpy.win32.owned_child", false);
+    HWND child = owned_child
+               ? SDL_GetPointerProperty(
+                     props, SDL_PROP_WINDOW_WIN32_HWND_POINTER, NULL)
+               : NULL;
+#endif
+
+    SDL_DestroyWindow(window);
+
+#ifdef _WIN32
+    if (child) {
+        DestroyWindow(child);
+    }
+#endif
+}
