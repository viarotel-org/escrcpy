 sc_sdl_create_window(const char *title, int64_t x, int64_t y, int64_t width,
-                     int64_t height, int64_t flags) {
+                     int64_t height, int64_t flags,
+                     uintptr_t parent_window_handle) {
     SDL_Window *window = NULL;
+#ifdef _WIN32
